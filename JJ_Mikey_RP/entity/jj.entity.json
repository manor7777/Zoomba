{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "jjmikey:jj",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/jj"
      },
      "geometry": {
        "default": "geometry.jjmikey.humanoid"
      },
      "animations": {
        "move": "animation.humanoid.move",
        "base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "sit": "animation.jjmikey.sit",
        "crouch": "animation.jjmikey.crouch"
      },
      "scripts": {
        "animate": [
          "base_pose",
          {
            "move": "query.is_moving && !query.property('jjmikey:sit')"
          },
          "look_at_target",
          {
            "sit": "query.property('jjmikey:sit')"
          },
          {
            "crouch": "query.property('jjmikey:crouch')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#aa0000",
        "overlay_color": "#5c342b"
      }
    }
  }
}